{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // リマインダーは実行時刻がユーザー入力で決まるため、Cloudflare 側の cron は
  // 毎分1本だけ回し、その中で D1 をポーリングする（docs/REMINDER.md §5）
  "triggers": { "crons": ["* * * * *"] },

  // すべて公開情報（秘密なのは Bot Token だけ）なのでコミットしてよい
  "vars": {
    "DISCORD_APPLICATION_ID": "1334491224127569940",
    "DISCORD_PUBLIC_KEY": "8189f9b158fe387b1a8ef07bc8553b4cbae2889524b8a30ff7867b67fc290eda",
    "DISCORD_GUILD_ID": "1211154854207160440",
    "DEFAULT_TIMEZONE": "Asia/Tokyo",

    // 「あとで読む」機能（docs/READ_LATER.md）。SOURCE_CHANNEL_ID と OWNER_ID が空なら無効。
    // Discord の開発者モードを ON にして、チャンネル / 自分のアイコンを右クリック >「ID をコピー」
    "READ_LATER_SOURCE_CHANNEL_ID": "",
    "READ_LATER_NOTIFY_CHANNEL_ID": "",
    "READ_LATER_OWNER_ID": "",
    "READ_LATER_DIGEST_TIME": "08:00",
    "READ_LATER_DIGEST_COUNT": "3",
    "READ_LATER_SNOOZE_DAYS": "7"
  },

  // DISCORD_BOT_TOKEN は secret。`wrangler secret put DISCORD_BOT_TOKEN` で設定する

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-bot",
      "database_id": "2d076bb2-a8f5-47ec-8e93-b252241946ab"
    }
  ]
}
